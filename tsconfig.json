{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "checkJs": false,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true
  },
  "exclude": [
    "node_modules/**",
    "src/service-worker.js",
    "src/service-worker/**/*.js",
    "src/service-worker.ts",
    "src/service-worker/**/*.ts",
    "src/service-worker.d.ts",
    "src/service-worker/**/*.d.ts",
    "src/viz/wasm/**/build/**",
    "src/viz/wasm/manifold-build/**",
    "src/viz/wasm/cgal/**",
    "src/viz/wasm/uv_unwrap/**",
    "src/viz/wasm/geodesics/**",
    "src/viz/wasm/clipper2/**",
    "src/viz/wasm/normals_bench/**",
    "src/viz/wasmComp/**",
    "src/ammojs/**",
    "src/geodesics/geodesics.js"
  ],
  "include": ["src", "e2e", "vite.config.js", "vitest.e2e.config.ts"]
}
