ring = build_path(path { rect(vec2(0.5, 0.5), 0.5) circle(vec2(0.5, 0.5), 0.15) | reverse })
rasterize_path(ring, width=64, height=64) | render_texture(name="fill")
rasterize_path(ring, width=64, height=64, fill_rule="evenodd") | render_texture(name="fill_evenodd")
path_sdf(ring, width=64, height=64) | render_texture(name="sdf")
wave = build_path(path { move(0, 0.5) cubic_bezier(vec2(0.33, 0.9), vec2(0.66, 0.1), vec2(1, 0.5)) })
path_uv(wave, width=64, height=32) | render_texture(name="uv")
path_sdf(wave, width=64, height=32) | render_texture(name="sdf_open")
dots = build_path(path { circle(vec2(0, 0), 0.2) circle(vec2(0.5, 0.5), 0.1) })
rasterize_path(dots, width=32, height=32, tileable=true) | render_texture(name="tiled_fill")
path_sdf(dots, width=32, height=32, tileable=0.5) | render_texture(name="tiled_sdf")
fitted = fit_path(build_path(path { rect(vec2(3, 7), vec2(6, 2)) }), pad=0.1)
rasterize_path(fitted, width=32, height=32) | render_texture(name="fit")
